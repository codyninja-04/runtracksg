NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Not used by the app today; billing will use it to write the
# plan into the billing table, which the browser can only read.
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-5-5.
CLAUDE_MODEL=
# Optional. Without it, weather comes from Open-Meteo (free, no key).
OPENWEATHER_API_KEY=
# Optional. Without it, routes are drawn as a plain trace instead of a map.
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Set to true once billing is live. Until then every account gets Pro features.
ENFORCE_PRO=false
